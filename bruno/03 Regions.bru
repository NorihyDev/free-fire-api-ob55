meta {
  name: Regions
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/regions
  body: none
  auth: none
}

tests {
  test("Recognized regions are listed", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().regions).to.be.an("array");
    expect(res.getBody().regions.map(r => r.code)).to.include("IND");
  });
}
