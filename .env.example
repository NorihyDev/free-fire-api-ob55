# Live is the default. Demo uses explicitly labelled synthetic fixtures.
FF_MODE=live
# session reuses an existing game JWT without contacting Garena auth endpoints.
# guest enables the older guest OAuth + MajorLogin flow.
FF_AUTH_METHOD=session
FF_RELEASE_VERSION=OB55
FF_ACCOUNTS_FILE=config/accounts.json
FF_SESSIONS_FILE=config/sessions.json
FF_DEFAULT_REGION=IND
# Optional protection for player endpoints (Bruno sends X-API-Key).
FF_API_KEY=
FF_TIMEOUT_SECONDS=15
FF_CACHE_TTL_SECONDS=30
FF_RATE_LIMIT_PER_MINUTE=60
# Configurable because unofficial game protocol settings can change.
FF_LOGIN_URL=https://loginbp.ggblueshark.com/MajorLogin
FF_TOKEN_URL=https://ffmconnect.live.gop.garenanow.com/oauth/guest/token/grant
FF_GUEST_REGISTER_URL=https://ffmconnect.live.gop.garenanow.com/oauth/guest/register
FF_UNITY_VERSION=2018.4.11f1
